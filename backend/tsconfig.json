{
  "compilerOptions": {
    // 文件布局
    "rootDir": "src",
    "outDir": "dist",

    // 模块系统（Node.js 后端使用 CommonJS 或 NodeNext）
    "module": "commonjs",
    "target": "ES2022",

    // Node.js 类型声明
    "types": ["node"],

    // 输出选项
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // 严格检查
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    // 模块检测
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}